# EGO LTD landing — SPA history fallback.
# Real files/dirs (assets, images, api/, app/) serve as-is; every other path
# routes to index.html so React Router routes (/services, /resources,
# /areas/north-london, …) resolve on hard load / refresh instead of 404ing.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Always revalidate HTML so a deploy's new hashed bundles are picked up at once (no stale
# "failed to load" blank page). Deliberately no long-lived rule for .js/images here: this
# file sits at the docroot, so it would cascade into /app/, whose sw.js is not hashed.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
