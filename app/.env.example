# Public values only (VITE_* ends up in the browser bundle). Copy to .env.local; never commit real secrets.
# Clerk publishable key for the instance you are using (dev: pk_test_..., live: pk_live_...).
# Leave unset to keep the legacy own-login.
VITE_CLERK_PUBLISHABLE_KEY=
# Optional: point dev at a local PHP API instead of the live one.
# VITE_API_BASE=
