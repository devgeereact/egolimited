# EGO LIMITED app — SPA history fallback.
# Serve real files/dirs as-is; route everything else to index.html so the
# React Router client routes (e.g. /app/welcome, /ego/jobs) resolve
# on hard load / refresh instead of 404ing.

# The host's default static-file caching applies a 1-year immutable Cache-Control to
# .js by extension, which also caught sw.js and index.html — a browser could run a
# service worker (or shell) up to a year stale, surviving deploys that delete the
# hashed assets it references (white-screen incident, 2026-07-08). Force these two
# always-revalidate; hashed /assets/*.js files are unaffected and stay long-cached.
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|index\.html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /app/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /app/index.html [L]
</IfModule>
