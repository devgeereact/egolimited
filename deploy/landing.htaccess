# EGO LTD landing — SPA history fallback + cache policy.
# Real files/dirs (assets, images, api/, app/) serve as-is; every other path
# routes to index.html so React Router routes resolve on hard load / refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Cache policy: always revalidate the HTML entry point so new hashed bundles
# are picked up immediately (prevents stale "failed to load" blank pages);
# fingerprinted build assets are immutable and cached hard.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|ttf|svg|png|jpe?g|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
